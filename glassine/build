#!/usr/bin/env bash
# SPDX-License-Identifier: BSD-3-Clause
#
# Build and sign the Onyx Boox Note Air ABL from this checkout's HEAD.
#
#   glassine/build [--out DIR] [--stamps "LOADER" "FASTBOOT"]
#
# --out DIR    where the build goes (default ~/.cache/glassine/abl). The source is
#              exported there from HEAD, so the checkout itself is never written.
# --stamps     the build date and time printed by "Loader Build Info" and "Fastboot
#              Build Info", each as "Mmm dd yyyy hh:mm:ss". Upstream uses __DATE__
#              and __TIME__ there, so without this two builds of the same commit
#              differ in those bytes. GLASSINE.md has the stamps of the
#              flashed build.
#
# Output: DIR/abl-unsigned.elf and DIR/abl.elf, signed in format v5 with a dummy
# certificate chain (qtestsign). The Note Air's boot chain rejects any other
# format, v3 included, without a message: the device drops into EDL.

set -euo pipefail

OUT="${HOME}/.cache/glassine/abl"
STAMP_LOADER=""
STAMP_FASTBOOT=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --out) OUT="$2"; shift 2 ;;
        --stamps) STAMP_LOADER="$2"; STAMP_FASTBOOT="$3"; shift 3 ;;
        -h|--help) sed -n '3,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

REPO="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
IMAGE="glassine-abl-builder"
QTESTSIGN_URL="https://github.com/msm8916-mainline/qtestsign.git"
QTESTSIGN_REV="f3df53a5f0e37ccee076541f30f9d5b8340fc2d3"

mkdir -p "$OUT"
OUT="$(cd "$OUT" && pwd)"

echo "build: exporting $(git -C "$REPO" rev-parse --short HEAD) to $OUT/src"
rm -rf "$OUT/src" "$OUT/intermediates" "$OUT/abl.elf" "$OUT/abl-unsigned.elf"
mkdir -p "$OUT/src" "$OUT/intermediates"
git -C "$REPO" archive HEAD | tar -x -C "$OUT/src"

stamp() {  # FILE "Mmm dd yyyy hh:mm:ss"
    local date="${2% *}" time="${2##* }"
    [[ "$2" =~ ^[A-Z][a-z]{2}\ [\ 0-9][0-9]\ [0-9]{4}\ [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] \
        || { echo "bad stamp: '$2' (want e.g. 'Jun  3 2026 15:38:04')" >&2; exit 2; }
    grep -q '__DATE__, __TIME__' "$1" || { echo "no __DATE__ in $1" >&2; exit 1; }
    sed -i "s/__DATE__, __TIME__/\"$date\", \"$time\"/" "$1"
}
if [[ -n "$STAMP_LOADER" ]]; then
    stamp "$OUT/src/QcomModulePkg/Application/LinuxLoader/LinuxLoader.c" "$STAMP_LOADER"
    stamp "$OUT/src/QcomModulePkg/Library/FastbootLib/FastbootMain.c" "$STAMP_FASTBOOT"
fi

if [[ ! -d "$OUT/qtestsign/.git" ]]; then
    git clone -q "$QTESTSIGN_URL" "$OUT/qtestsign"
fi
git -C "$OUT/qtestsign" -c advice.detachedHead=false checkout -q "$QTESTSIGN_REV"

docker build -q -t "$IMAGE" "$REPO/glassine" >/dev/null

FLAGS=(
    BOOTLOADER_OUT=/workspace/out/intermediates/ABL_OBJ
    CLANG_BIN=/usr/bin/
    CLANG_PREFIX=aarch64-linux-gnu-
    TARGET_ARCHITECTURE=AARCH64
    BOARD_BOOTLOADER_PRODUCT_NAME=NoteAir
    BUILD_SYSTEM_ROOT_IMAGE=1
    VERIFIED_BOOT=0
    VERIFIED_BOOT_2=0
    VERIFIED_BOOT_LE=0
    USER_BUILD_VARIANT=0
    DISABLE_PARALLEL_DOWNLOAD_FLASH=0
    ABL_SAFESTACK=false
    ABL_USE_SDLLVM=false
)

# Upstream compiles __FILE__ into the image, so the source and output paths inside the
# container are part of the build: keep /workspace/src and /workspace/out.
# A parallel first build sometimes races in BaseTools; one retry at -j1 gets past it.
if ! docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp \
    -v "$OUT/src:/workspace/src" -v "$OUT:/workspace/out" -w /workspace/src "$IMAGE" bash -c "
        set -e
        make -j$(nproc) ${FLAGS[*]} all || make -j1 ${FLAGS[*]} all
        cp /workspace/out/abl.elf /workspace/out/abl-unsigned.elf
        python3 /workspace/out/qtestsign/qtestsign.py -v 5 abl \
            /workspace/out/abl-unsigned.elf -o /workspace/out/abl.elf
    " >"$OUT/build.log" 2>&1; then
    tail -20 "$OUT/build.log" >&2
    echo "build failed, see $OUT/build.log" >&2
    exit 1
fi
grep -E '^FVMAIN' "$OUT/build.log"
cmp -s "$OUT/abl.elf" "$OUT/abl-unsigned.elf" && { echo "signing did nothing" >&2; exit 1; }
echo "build: $(sha256sum "$OUT/abl-unsigned.elf" | cut -d' ' -f1)  abl-unsigned.elf"
echo "build: $(sha256sum "$OUT/abl.elf" | cut -d' ' -f1)  abl.elf (signed, v5)"
